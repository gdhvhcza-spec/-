<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>مدرستي الذكية | Smart School AI</title>
    <!-- الخطوط والرسوم -->
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --p: #4f46e5; --a: #f59e0b; --bg: #f8fafc; --c: #ffffff;
            --t: #1e293b; --d: #ef4444; --s: #10b981; --glass: rgba(255, 255, 255, 0.9);
            --gemini-gradient: linear-gradient(90deg, #4285f4, #9b72cb, #d96570);
        }
        [data-theme="dark"] {
            --bg: #0f172a; --c: #1e293b; --t: #f1f5f9; --glass: rgba(15, 23, 42, 0.9);
        }
        * { box-sizing: border-box; font-family: 'Tajawal', sans-serif; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        body { background: var(--bg); color: var(--t); margin: 0; padding: 0; overflow-x: hidden; }

        /* --- القائمة الجانبية (Menu) --- */
        .sidebar { 
            position: fixed; top: 0; right: -100%; width: 290px; height: 100%; 
            background: var(--c); z-index: 10001; padding: 40px 15px; 
            box-shadow: -10px 0 30px rgba(0,0,0,0.2);
        }
        .sidebar.active { right: 0; }
        .overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.4); display: none; z-index: 10000; }
        .overlay.active { display: block; }
        
        .menu-btn { 
            position: fixed; top: 15px; right: 15px; z-index: 10002; 
            background: var(--c); color: var(--p); width: 45px; height: 45px; 
            border-radius: 12px; display: flex; align-items: center; justify-content: center; 
            cursor: pointer; font-size: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border: 1px solid #ddd;
        }

        .nav-item { 
            padding: 12px 15px; margin: 8px 0; border-radius: 12px; cursor: pointer; 
            display: flex; align-items: center; gap: 12px; font-weight: 500;
        }
        .nav-item:hover { background: var(--bg); border-right: 4px solid var(--p); }
        .nav-item.active { background: var(--p); color: white; }

        /* --- الواجهة الرئيسية --- */
        .container { max-width: 800px; margin: 80px auto 20px; padding: 0 20px; }
        .section { display: none; }
        .section.active { display: block; animation: slideUp 0.4s ease; }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        .card { background: var(--c); border-radius: 24px; padding: 25px; margin-bottom: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.02); border-right: 6px solid var(--p); }
        .btn { border: none; padding: 14px; border-radius: 14px; cursor: pointer; font-weight: bold; width: 100%; display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 15px; }
        .btn-p { background: var(--p); color: white; }
        .btn-a { background: var(--a); color: white; }

        /* --- المعلم السقراطي (Gemini Style) --- */
        .gemini-header { height: 4px; width: 100%; background: var(--gemini-gradient); border-radius: 10px; margin-bottom: 15px; }
        .chat-box { height: 400px; overflow-y: auto; padding: 15px; background: rgba(0,0,0,0.01); border-radius: 20px; margin-bottom: 15px; display: flex; flex-direction: column; }
        .msg { padding: 12px 18px; border-radius: 20px; margin-bottom: 12px; max-width: 85%; font-size: 15px; line-height: 1.6; position: relative; }
        .msg.bot { background: white; border: 1px solid #e2e8f0; align-self: flex-start; color: var(--t); }
        .msg.user { background: var(--p); color: white; align-self: flex-end; }
        .typing { font-size: 12px; color: #666; margin-bottom: 10px; display: none; }

        /* --- الكتب والتقدم --- */
        .books-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 15px; }
        .book-item { background: var(--c); padding: 20px; border-radius: 20px; text-align: center; border: 1px solid #eee; cursor: pointer; }
        .book-item i { font-size: 35px; display: block; margin-bottom: 10px; }
        .mastery-chart { width: 100%; max-height: 300px; }

        .hidden { display: none; }
        input, select, textarea { width: 100%; padding: 14px; border-radius: 14px; border: 1px solid #e2e8f0; margin-bottom: 15px; background: var(--c); color: var(--t); outline: none; }
    </style>
</head>
<body data-theme="light">

    <!-- الثلاث شرطات (Menu) -->
    <div class="menu-btn" onclick="toggleMenu()">☰</div>
    <div class="overlay" id="overlay" onclick="toggleMenu()"></div>

    <!-- القائمة الجانبية كاملة الأقسام -->
    <nav class="sidebar" id="sidebar">
        <h2 style="color: var(--p); margin-bottom: 30px;">مدرستي الذكية 🇵🇸</h2>
        <div class="nav-item active" onclick="show('home', this)">🏠 الرئيسية</div>
        <div class="nav-item" onclick="show('books', this)">📚 الكتب (المنهاج)</div>
        <div class="nav-item" onclick="show('tasks', this)">📅 المهام والامتحانات</div>
        <div class="nav-item" onclick="show('ai', this)">🤖 المعلم السقراطي (AI)</div>
        <div class="nav-item" onclick="show('brain', this)">🧠 عقل الطالب (الإتقان)</div>
        <div class="nav-item" onclick="show('focus', this)">⏱️ وضع التركيز</div>
        <div class="nav-item" onclick="show('teacher', this)">🔐 وضع المعلم</div>
        <div class="nav-item" onclick="show('settings', this)">⚙️ الإعدادات</div>
    </nav>

    <div class="container">
        <!-- 1.
